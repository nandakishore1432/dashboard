rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['userName', 'accentColor', 'showMesh', 'showSubtaskCounts', 'updatedAt'])
      );

      function isValidUser(data) {
        return data.userName is string && data.userName.size() <= 50 &&
               data.email is string && data.email.size() <= 100 &&
               (data.accentColor == null || (data.accentColor is string && data.accentColor.size() <= 20)) &&
               (data.showMesh == null || data.showMesh is bool) &&
               (data.showSubtaskCounts == null || data.showSubtaskCounts is bool);
      }
    }

    // Tasks Collection
    match /tasks/{taskId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isOwner(existing().userId);
      allow create: if isOwner(incoming().userId) && isValidTask(incoming());
      allow update: if isOwner(existing().userId) && isOwner(incoming().userId) && isValidTask(incoming()) && (
        // Action: Toggle Complete
        (incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'updatedAt'])) ||
        // Action: Manage Subtasks
        (incoming().diff(existing()).affectedKeys().hasOnly(['subtasks', 'updatedAt'])) ||
        // Action: Edit Title
        (incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt']))
      );
      allow delete: if isOwner(existing().userId);

      function isValidTask(data) {
        return data.title is string && data.title.size() <= 200 &&
               data.completed is bool &&
               data.userId == request.auth.uid &&
               data.subtasks is list && data.subtasks.size() <= 100 &&
               (data.subtasks.size() == 0 || (data.subtasks[0].title is string && data.subtasks[0].title.size() <= 200));
      }
    }
  }
}
